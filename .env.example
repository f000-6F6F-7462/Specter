# Copy to .env for local development. All keys are prefixed SPECTER_ and nested
# groups use a double-underscore delimiter, e.g. SPECTER_REDIS__URL.

SPECTER_ENV=local

SPECTER_BUS=redis         # redis | memory
SPECTER_BLOB=minio        # minio | memory
SPECTER_VECTORS=qdrant    # qdrant | memory
SPECTER_INFERENCE=insightface  # insightface

SPECTER_LOG__LEVEL=INFO
SPECTER_LOG__JSON=false

SPECTER_REDIS__URL=redis://localhost:6379/0
SPECTER_DATABASE__URL=postgresql+asyncpg://specter:specter@localhost:5432/specter
SPECTER_QDRANT__URL=http://localhost:6333

SPECTER_S3__ENDPOINT_URL=http://localhost:9000
SPECTER_S3__ACCESS_KEY=specter
SPECTER_S3__SECRET_KEY=specter123
SPECTER_S3__BUCKET=specter

SPECTER_SECURITY__API_KEY=dev-only-change-me
SPECTER_SECURITY__SECRET_KEY=dev-only-fernet-key-change-me

SPECTER_MODELS__DETECTOR__DEVICE=mps
