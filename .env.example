# The one settings file of the whole system: the engine (Specter) and the dashboard. `make up` and
# `make engine-up` copy it to .env on first run, with a generated JWT_SECRET, and every part run
# from source reads the same .env (see docs/running.md).
#
# Only the required values are set here. Every other line shows a setting commented out with its
# default, which lives in the code; uncomment a line only to change it. Quote a value that
# contains a space. Addresses between the services are not settings: the Compose files and
# config/specter.dev.yaml wire them.

# --- Required ------------------------------------------------------------------------------------

# The dashboard's users and cameras live in Supabase.
SUPABASE_URL=
SUPABASE_KEY=
# Signs user sessions. Generated on first run; changing it logs every user out.
JWT_SECRET=

# --- Dashboard -----------------------------------------------------------------------------------

# The port `make up` serves the web application on, on every network interface.
# DASHBOARD_PORT=8080
# The Specter owner that every camera, watchlist and alert of this dashboard belongs to.
# SPECTER_OWNER_ID=facealert
# JWT_EXPIRES_IN=7d
# BCRYPT_SALT_ROUNDS=10
# Comma-separated browser origins allowed to call the API from another origin. Unset, any
# localhost origin is allowed; `make up` serves the client from the API's own origin anyway.
# ALLOWED_ORIGINS=
# E-mail through SendGrid; unset, no e-mail is sent.
# SENDGRID_API_KEY=
# EMAIL_SENDER=no-reply@specter.com
# EMAIL_SENDER_NAME=Specter System
# Testmail.app credentials, required only for the email delivery E2E test.
# TESTMAIL_API_KEY=
# TESTMAIL_NAMESPACE=
# Google sign-in; unset, it is disabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Engine (Specter) ----------------------------------------------------------------------------
# Every engine setting is SPECTER_<SECTION>__<FIELD>, validated by src/specter/config/settings.py.

# pc-cpu, pc-nvidia, jetson or raspberry-pi. Picks the models and the detector's batching.
# SPECTER_DEVICE__HARDWARE_PROFILE=pc-cpu
# The inference runtime installed in the image, read when it is built: onnxruntime for pc-cpu,
# pc-nvidia and jetson; ncnn for raspberry-pi.
# SPECTER_EXTRA=onnxruntime
# SPECTER_DEVICE__NAME=specter

# The same target on the same camera raises at most one alert within this time.
# SPECTER_MATCHING__COOLDOWN_SECONDS=30
# Alert snapshots older than this are removed, whole days at a time.
# SPECTER_EVIDENCE__MAXIMUM_AGE_DAYS=30
# The oldest days are removed first once evidence uses more than this.
# SPECTER_EVIDENCE__MAXIMUM_SIZE_GIBIBYTES=5
# Larger reference image uploads are refused.
# SPECTER_API__MAXIMUM_IMAGE_SIZE_MEBIBYTES=10
# The hardware profile sets these; set one only to override it.
# SPECTER_DETECTOR__MAX_BATCH_SIZE=4
# SPECTER_DETECTOR__MAX_BATCH_DELAY_MILLISECONDS=5

# DEBUG, INFO, WARNING or ERROR.
# SPECTER_LOGGING__LEVEL=INFO
# text or json.
# SPECTER_LOGGING__FORMAT=text

# Where viewers reach go2rtc's WebRTC port, such as 192.168.1.50:8555. stun:8555 discovers it.
# GO2RTC_WEBRTC_CANDIDATES=stun:8555
