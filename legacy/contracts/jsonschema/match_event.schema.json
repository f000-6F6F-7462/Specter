{
  "$defs": {
    "BBoxModel": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "exclusiveMinimum": 0,
          "title": "H",
          "type": "integer"
        },
        "norm": {
          "default": false,
          "title": "Norm",
          "type": "boolean"
        },
        "w": {
          "exclusiveMinimum": 0,
          "title": "W",
          "type": "integer"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "BBoxModel",
      "type": "object"
    },
    "Dedup": {
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "first_seen_at": {
          "format": "date-time",
          "title": "First Seen At",
          "type": "string"
        },
        "hit_count": {
          "minimum": 1,
          "title": "Hit Count",
          "type": "integer"
        },
        "window_ms": {
          "minimum": 0,
          "title": "Window Ms",
          "type": "integer"
        }
      },
      "required": [
        "correlation_id",
        "hit_count",
        "window_ms",
        "first_seen_at"
      ],
      "title": "Dedup",
      "type": "object"
    },
    "DetectionInfo": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BBoxModel"
        },
        "class": {
          "title": "Class",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "frame_id": {
          "minimum": 0,
          "title": "Frame Id",
          "type": "integer"
        },
        "frame_ts": {
          "format": "date-time",
          "title": "Frame Ts",
          "type": "string"
        },
        "track_id": {
          "minimum": 0,
          "title": "Track Id",
          "type": "integer"
        }
      },
      "required": [
        "class",
        "confidence",
        "bbox",
        "frame_ts",
        "frame_id",
        "track_id"
      ],
      "title": "DetectionInfo",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "clip_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Url"
        },
        "crop_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Url"
        },
        "snapshot_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Url"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "MatchInfo": {
      "additionalProperties": false,
      "properties": {
        "calibrated_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibrated Confidence"
        },
        "distance_metric": {
          "default": "cosine",
          "title": "Distance Metric",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "similarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Similarity",
          "type": "number"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "target_label": {
          "title": "Target Label",
          "type": "string"
        },
        "target_type": {
          "title": "Target Type",
          "type": "string"
        },
        "threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        },
        "watchlist_id": {
          "title": "Watchlist Id",
          "type": "string"
        },
        "watchlist_name": {
          "title": "Watchlist Name",
          "type": "string"
        }
      },
      "required": [
        "watchlist_id",
        "watchlist_name",
        "kind",
        "target_id",
        "target_label",
        "target_type",
        "similarity",
        "threshold"
      ],
      "title": "MatchInfo",
      "type": "object"
    },
    "StreamRef": {
      "additionalProperties": false,
      "properties": {
        "camera_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "StreamRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dedup": {
      "$ref": "#/$defs/Dedup"
    },
    "detection": {
      "$ref": "#/$defs/DetectionInfo"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "match": {
      "$ref": "#/$defs/MatchInfo"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "owner_id": {
      "title": "Owner Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stream": {
      "$ref": "#/$defs/StreamRef"
    },
    "type": {
      "const": "match_event",
      "default": "match_event",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "owner_id",
    "stream",
    "match",
    "detection",
    "dedup"
  ],
  "title": "MatchEventMessage",
  "type": "object"
}
