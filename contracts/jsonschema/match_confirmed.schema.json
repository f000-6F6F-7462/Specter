{
  "$defs": {
    "EmbeddingModality": {
      "description": "What an embedding describes.",
      "enum": [
        "face",
        "appearance"
      ],
      "title": "EmbeddingModality",
      "type": "string"
    },
    "MessageBoundingBox": {
      "additionalProperties": false,
      "description": "A bounding box as fractions of the frame's width and height.",
      "properties": {
        "height": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "MessageBoundingBox",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A camera's track was confirmed as a watchlist target.",
  "properties": {
    "bounding_box": {
      "$ref": "#/$defs/MessageBoundingBox"
    },
    "camera_id": {
      "title": "Camera Id",
      "type": "string"
    },
    "first_seen_at": {
      "format": "date-time",
      "title": "First Seen At",
      "type": "string"
    },
    "frame_captured_at": {
      "format": "date-time",
      "title": "Frame Captured At",
      "type": "string"
    },
    "margin_ratio": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Margin Ratio",
      "type": "number"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "modality": {
      "$ref": "#/$defs/EmbeddingModality"
    },
    "object_class": {
      "title": "Object Class",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "owner_id": {
      "title": "Owner Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "similarity_ratio": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Similarity Ratio",
      "type": "number"
    },
    "snapshot_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Path"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "threshold_ratio": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Threshold Ratio",
      "type": "number"
    },
    "track_id": {
      "minimum": 0,
      "title": "Track Id",
      "type": "integer"
    },
    "watchlist_id": {
      "title": "Watchlist Id",
      "type": "string"
    }
  },
  "required": [
    "occurred_at",
    "owner_id",
    "camera_id",
    "track_id",
    "watchlist_id",
    "target_id",
    "modality",
    "similarity_ratio",
    "margin_ratio",
    "threshold_ratio",
    "object_class",
    "bounding_box",
    "first_seen_at",
    "frame_captured_at"
  ],
  "title": "MatchConfirmedMessage",
  "type": "object"
}
