{
  "$defs": {
    "CameraStatus": {
      "description": "Live state of a camera process.",
      "enum": [
        "starting",
        "running",
        "reconnecting",
        "stopped",
        "failed"
      ],
      "title": "CameraStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A camera process changed its live status.",
  "properties": {
    "camera_id": {
      "title": "Camera Id",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "owner_id": {
      "title": "Owner Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CameraStatus"
    }
  },
  "required": [
    "occurred_at",
    "owner_id",
    "camera_id",
    "status"
  ],
  "title": "CameraStatusChangedMessage",
  "type": "object"
}
